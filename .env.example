MYSQL_ROOT_PASSWORD=root
DB_NAME=taxify_dev
DB_USER=taxify
DB_PASSWORD=taxify

SIEG_CLIENT_ID=
SIEG_CLIENT_SECRET=

# Opcional: chave AES-256 que cifra os certificados A1 (.pfx no S3) e as senhas (no banco).
# Vazia = guardados sem essa criptografia (só a do bucket). Gere com: openssl rand -base64 32
# e guarde uma cópia: sem ela os certificados cifrados precisam ser reenviados.
CERT_ENCRYPTION_KEY=

# App Taxify no Portal do Desenvolvedor da Conta Azul. O redirect URI tem que ser IGUAL ao
# cadastrado no app e apontar para a rota do front que recebe o retorno do login:
# https://SEU_DOMINIO/integracoes/conta-azul/callback
CONTA_AZUL_CLIENT_ID=
CONTA_AZUL_CLIENT_SECRET=
CONTA_AZUL_REDIRECT_URI=
# Opcionais (já têm padrão no docker-compose.yml / application.yaml):
# CONTA_AZUL_AUTHORIZE_URL=https://login.contaazul.com/#/oauth/authorize
# CONTA_AZUL_TOKEN_URL=https://api-v2.contaazul.com/oauth/token

# Liga/desliga (padrão true) - sem nada aqui valem os padrões do docker-compose.yml:
# SEFAZ_AUTO_CIENCIA=true
# NFSE_ADN_ENABLED=true
# NFSE_ADN_CRON=0 25 * * * *
# NFSE_ADN_PRODUCTION=true
# PENDENCIES_ENABLED=true
# PENDENCIES_CRON=0 40 * * * *
# AUDIT_ENABLED=true
# AUDIT_CRON=0 30 5 * * *

# Memória (opcional). Heap do Java em % da RAM da máquina e cache do MySQL.
# Padrões pensados para 2 a 4 GB com o MySQL na mesma máquina.
# JAVA_OPTS=-XX:MaxRAMPercentage=45 -XX:+ExitOnOutOfMemoryError
# MYSQL_INNODB_BUFFER_POOL=256M
